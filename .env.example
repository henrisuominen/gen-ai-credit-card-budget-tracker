# Vertex AI & Gemini Enterprise Configuration
# Runtime resource IDs and secrets are loaded dynamically from Google Cloud Secret Manager
# via Application Default Credentials (ADC) / Workload Identity.
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_GENAI_USE_ENTERPRISE=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
DOCUMENT_AI_LOCATION=us
DOCUMENT_AI_PROCESSOR_ID=document-ai-processor-id
SECRET_MANAGER_CONFIG_SECRET_ID=budget-tracker-runtime-config
